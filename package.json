{
  "name": "@tuned-tensor/cli",
  "version": "0.13.1",
  "description": "Local TT agent and CUDA fine-tuning CLI for Tuned Tensor workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunedtensor/tuned-tensor-cli.git"
  },
  "type": "module",
  "bin": {
    "tt": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:cli && npm run test:local-runtime && npm run test:python",
    "test:cli": "vitest run",
    "test:local-runtime": "node --import tsx --test \"test/local-runtime/**/*.test.ts\"",
    "test:python": "python3 -m unittest discover -s training/adapter/tests -p 'test_*.py' && uv run --frozen --project training/foundation python -m unittest discover -s training/foundation/tests -p 'test_*.py'",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "training/adapter/pyproject.toml",
    "training/adapter/uv.lock",
    "training/adapter/src/*.py",
    "training/foundation/pyproject.toml",
    "training/foundation/uv.lock",
    "training/foundation/src/*.py",
    "docs/local-runtime",
    "examples/local-runtime/*.json",
    "examples/local-runtime/*.jsonl"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "llm",
    "fine-tuning",
    "cli",
    "agent",
    "pi",
    "tuned-tensor"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@tuned-tensor/pipeline-contract": "1.1.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "open": "^10.1.0",
    "ora": "^9.3.0",
    "typebox": "1.3.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
