{
  "name": "@tuned-tensor/cli",
  "version": "0.9.0",
  "description": "Local Pi agent and unified cloud/local CLI for Tuned Tensor workflows",
  "type": "module",
  "bin": {
    "tt": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "llm",
    "fine-tuning",
    "cli",
    "agent",
    "pi",
    "tuned-tensor"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@tuned-tensor/local": "0.4.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "open": "^10.1.0",
    "ora": "^9.3.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
